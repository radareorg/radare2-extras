NAME=MN103 disassembly and analysis of a firmware reset vector
FILE=malloc://64
ARGS=-a mn103 -e log.level=0
CMDS=<<EOF
wx fafcfff0cbf8fefcfcff8c000000fcde000010988f10f81e08dd710600000000f0f4
pi 9
aoj~{[0].size}
aoj~{[0].type}
aoj 9~{[7].type}
aoj 9~{[7].jump}
aoj 9~{[7].stackptr}
aoj 9~{[8].type}
EOF
EXPECT=<<EOF
and 0xf0ff, psw
nop
add -0x4, sp
calls 0x00000094
mov 0x98100000, a2
mov 0x10, d3
mov d3, (0x8, a2)
call 0x0000068a, [], 0x0
jmp (a0)
4
and
call
1674
4
rjmp
EOF
RUN

NAME=MN103 cpu levels name the udf slots
FILE=malloc://8
ARGS=-a mn103 -e log.level=0
CMDS=<<EOF
wx f60cf9140a
pi 2
e asm.cpu=mn10300
pi 2
EOF
EXPECT=<<EOF
mulq d3, d0
mulqu 0xa, d0
udf00 d3, d0
udfu01 0xa, d0
EOF
RUN

NAME=MN103 pseudo syntax
FILE=malloc://16
ARGS=-a mn103 -e asm.pseudo=true -e log.level=0
CMDS=<<EOF
wx 8f10f81e08f26c1fdfc008
pi 5
EOF
EXPECT=<<EOF
d3 = 0x10
[a2 + 0x8] = d3
d0 = mdr:d0 / d3
d3 = (uint16_t) d3
return (restore [d2,d3], frame 0x8)
EOF
RUN

